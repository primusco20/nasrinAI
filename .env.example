# NasrinAI server settings. Put real values in Vercel > Settings > Environment Variables.
# Never commit real values. None of these are sent to browsers.

NODE_ENV=production
# PORT is only used when running locally.
# Proxies in front of the server (Vercel = 1). Used to find the real client IP.
TRUST_PROXY_HOPS=1

# --- NasrinAI's own Supabase project (required in production) ---
# Supabase > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=            # anon / publishable key (used only to check sign-ins)
SUPABASE_SECRET_KEY=    # service-role / secret key: server only, never in a page

# --- Guest sessions (required in production) ---
# 32+ random characters. Changing it signs every guest out. One way to make it, in
# the Supabase SQL Editor: select encode(extensions.gen_random_bytes(32), 'hex');
GUEST_SESSION_SECRET=
GUEST_SESSION_TTL_HOURS=24

# --- Sign-in on the page (see docs/sign-in.md) ---
AUTH_EMAIL=true                # email codes; needs SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY
AUTH_GOOGLE=false              # true after Google is set up in Supabase
# SITE_URL=https://nasrinai.com   # needed for Google

# --- AI provider routing ---
# Provider keys are server-only. Claude is optional; routing skips it when unset.
# ANTHROPIC_API_KEY=
# Smart routing chooses capability -> level -> provider/model -> fallback -> validation.
ROUTING=smart
ROUTE_RANGE_NASRINAI=1-2
ROUTE_RANGE_PRO=1-3
ROUTE_RANGE_MAX=1-4
ROUTE_RANGE_ULTRA=1-5
# Experimental multi-model planning council for eligible Max/Ultra tasks; OFF by default.
# PLANNING_COUNCIL_ENABLED=false
# General routing uses Gemini/OpenAI. Claude is deliberately excluded from the
# general pool and is reserved for coding/debugging on Max and Ultra only.
# ROUTE_LEVEL_1=gemini:gemini-3.1-flash-lite,openai:gpt-5.4-nano:none
# Council candidates are operator-configured and must be verified/priced first. Example order (lowest-cost first):
# ROUTE_LEVEL_1=openrouter:inclusionai/ling-3.1-flash,openrouter:deepseek/deepseek-v4.1-flash-1017,openrouter:openai/gpt-6-luna,openrouter:qwen/qwen3.8-flash
# ROUTE_LEVEL_2=openai:gpt-5.4-mini:low
# ROUTE_LEVEL_3=openai:gpt-5.4:medium
# ROUTE_LEVEL_4=openai:gpt-5.4:high
# ROUTE_LEVEL_5=openai:gpt-5.4:high
# Coding specialists (only used for coding/debugging on Max/Ultra).
# Max uses OpenRouter GPT-6 Sol; Ultra uses GPT-6.1 Sol, including Ultra deep coding.
# Both list $2 input / $10 output per 1M tokens; cached-input rates differ by model.
# Set these in Vercel only after verifying provider access and running Preview smoke tests.
# Max coding: GPT-6 Sol ($2 input / $10 output per 1M; cached input $0.20/M).
# CODING_MAX_MODEL=openrouter:openai/gpt-6-sol
# Max coding: GPT-6 Sol ($2 input / $10 output per 1M; cached input $0.20/M).
# CODING_MAX_MODEL=openrouter:openai/gpt-6-sol
# Ultra coding: GPT-6.1 Sol ($2 input / $10 output per 1M; cached input $0.10/M).
# CODING_ULTRA_MODEL=openrouter:openai/gpt-6.1-sol
# CODING_ULTRA_DEEP_MODEL=openrouter:openai/gpt-6.1-sol

# OpenRouter TTS: Google Gemini 3.8 Flash Lite TTS ($0.50 text input / $6 audio output per 1M tokens).
# Pin to Google AI Studio; the OpenRouter adapter disables provider fallback when pinned.
# Configure in Vercel Preview first and verify the endpoint supports speech output before production.
# SPEECH_PROVIDER=openrouter
# OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts
# OPENROUTER_TTS_PROVIDER=Google AI Studio

# --- Plans for Max and Ultra (see docs/plans.md) ---
PLANS_ENABLED=true             # false: every signed-in user can use every tier
# PLAN_MAX_PRICE=              # whole pesos per 30 days; empty = "Coming soon"
# PLAN_ULTRA_PRICE=
# PLAN_MAX_ANNUAL_PRICE=        # whole pesos per 365 days; empty = annual option unavailable
# PLAN_ULTRA_ANNUAL_PRICE=
# --- Ultra video generation ---
# Final-quality default: Gemini Veo 3.1 Standard (native audio, 1080p).
# Use veo-3.1-fast-generate-preview only when lower cost/latency is preferred.
# VIDEO_ENABLED=true
# VIDEO_PROVIDER=openrouter
# Optional per-tier model IDs. Omit to discover compatible models from the live catalog.
# OPENROUTER_VIDEO_PRO_MODEL=provider/model-id # Pro: 720p
# OPENROUTER_VIDEO_MAX_MODEL=provider/model-id
# OPENROUTER_VIDEO_ULTRA_MODEL=provider/model-id
# Legacy single-model fallback for Ultra only:
# OPENROUTER_VIDEO_MODEL=provider/model-id
# Video pricing is verified from the live catalog; do not enter a guessed per-second cost.
# VIDEO_RESOLUTION=720p
# VIDEO_PER_HOUR=1

# PayMongo (all three, plus SITE_URL, turn payments on)
# PAYMONGO_SECRET_KEY=         # sk_test_… or sk_live_…; server only
# PAYMONGO_WEBHOOK_SECRET=     # whsk_… from the webhook for checkout_session.payment.paid
# PAYMONGO_METHODS=gcash,paymaya,card

# --- Connectors (Phase 6, docs/connectors.md) ---
# CONNECTOR_SECRET_KEY=        # openssl rand -hex 32; encrypts businesses' API keys (sensitive)

# --- Facebook Messenger (Phase 6, docs/facebook.md) ---
# FACEBOOK_APP_SECRET=         # Meta app secret (sensitive)
# FACEBOOK_VERIFY_TOKEN=       # random text, same as in the Meta webhook setup (sensitive)
# FACEBOOK_GRAPH_VERSION=      # optional, e.g. v23.0

# GitHub for the coding chat (docs/github.md). Needs CONNECTOR_SECRET_KEY (tokens are stored encrypted).
# GITHUB_APP_CLIENT_ID=         # GitHub App → Client ID (Iv23li…)
# GITHUB_APP_CLIENT_SECRET=     # GitHub App → Client secrets (sensitive)
# GITHUB_APP_SLUG=              # the app's URL name, for the "Choose repositories" link
# AGENT_BROWSER_SNAPSHOT_ID=    # render-and-test browser (node scripts/create-browser-snapshot.mjs prints it)

# --- Founder's portfolio for questions about Nasrin Abubakar (docs/knowledge.md) ---
# FOUNDER_KNOWLEDGE_URL=https://nasrinai.com/api/knowledge

# --- Tools in chat (Phase 5, docs/tools.md) ---
# TOOLS_ENABLED=true           # false: chat never offers tools

# --- Projects (migration 013, docs/projects.md) ---
# PROJECTS_ENABLED=true            # false: no Projects
# PROJECTS_MAX=50                  # per person
# PROJECT_TASKS_MAX=100            # per project

# --- NCC, Nasrin Client Connect (migration 040, docs/ncc.md) ---
# NCC_ENABLED=false                # true: NCC works for the accounts below
# NCC_ACCOUNTS=                    # sign-in emails of enabled businesses, comma-separated
# NCC_URL=https://ncc.nasrinai.com # the NCC app's own address (Google sign-in returns there)
# NCC_CONTACTS_MAX=2000            # per account
# NCC_DEALS_MAX=2000               # per account
# LIMIT_USER_NCC_HOUR=600          # NCC changes per account per hour

# --- Library (migration 012, docs/library.md) ---
# LIBRARY_ENABLED=true             # false: no Library
# LIBRARY_MAX_FILES=100            # per person
# LIBRARY_MAX_TOTAL_CHARS=2000000  # per person, all files together

# --- Limits (optional; defaults shown) ---
# Hourly counts, shared by every server instance.
LIMIT_GUEST_SESSIONS_PER_IP_HOUR=10
LIMIT_GUEST_MESSAGES_HOUR=20
LIMIT_USER_MESSAGES_HOUR=60
LIMIT_SERVICE_MESSAGES_HOUR=600
LIMIT_IP_MESSAGES_HOUR=120
# Natural-voice read-alouds (also counted per IP under LIMIT_IP_MESSAGES_HOUR).
LIMIT_GUEST_SPEECH_HOUR=20
LIMIT_USER_SPEECH_HOUR=120
# Sign-in: codes per IP and per address, code attempts per address, refreshes per IP.
LIMIT_SIGNIN_CODES_IP_HOUR=10
LIMIT_SIGNIN_CODES_EMAIL_HOUR=4
LIMIT_SIGNIN_TRIES_HOUR=10
LIMIT_SIGNIN_REFRESH_IP_HOUR=300
# Token quota policy: Quick has no per-user or platform-wide token ceiling.
# In Vercel Production, set all three paid weekly allowances explicitly.
# These values are enforced by the server and must be positive whole numbers.
PRO_WEEKLY_TOKEN_LIMIT=1000000
MAX_WEEKLY_TOKEN_LIMIT=5000000
ULTRA_WEEKLY_TOKEN_LIMIT=10000000
# Optional owner-only diagnostic. Generate a random secret of at least 32 characters.
# Send it in X-Owner-Diagnostics-Token to GET /v1/owner/quota-config.
# Never use a public value or expose this token in frontend code.
OWNER_DIAGNOSTICS_TOKEN=
# Owner Console is disabled until all three settings below are valid. Server-only; never use NEXT_PUBLIC_*.
# Exact verified sign-in emails and exact public IPv4 or IPv6 addresses, comma-separated; no CIDR ranges.
OWNER_ALLOWED_EMAILS=
OWNER_ALLOWED_IPS=
# Dedicated random signing value of at least 32 characters; do not reuse another secret.
OWNER_SESSION_SECRET=
# Free/default allowance for each signed-in user.
USER_DAILY_TOKEN_LIMIT=100000
# Active paid plan allowance per signed-in user, reset at midnight Manila time.
MAX_DAILY_TOKEN_LIMIT=500000
ULTRA_DAILY_TOKEN_LIMIT=2000000
# Each business's total is tenants.daily_token_limit in the database.

# --- AI provider ---
# auto (recommended: register all configured providers and fail over), openai, gemini,
# claude (Anthropic), local (your own model server), none, or fake (tests only).
# In auto mode, set the keys for all providers you want available; local is optional.
AI_PROVIDER=auto
OPENAI_API_KEY=               # server only
GEMINI_API_KEY=               # server only
ANTHROPIC_API_KEY=            # server only
# Optional Groq provider (OpenAI-compatible). Free-tier-only configuration:
# use a model listed in Groq's current Free Plan Limits; keep the model allowlist
# explicit so Groq cannot enter free fallback routing with a non-allowlisted model.
# Free-plan availability and limits can change; verify in Groq Console before use.
GROQ_API_KEY=                 # server only; https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FREE_MODELS=openai/gpt-oss-20b
# NasrinAI tiers: what people pick in the chat. Each points to a real model,
# optionally with a thinking effort after a colon. Leave one empty to turn it off.
# A tier is only shown if your OpenAI key can use its model.
TIER_NASRINAI=gpt-4o-mini      # the default, open to everyone (OPENAI_MODEL also sets it)
TIER_PRO=gpt-5-mini
TIER_MAX=gpt-5
TIER_ULTRA=gpt-5:high
# Realtime voice: server resolves the tier first. Quick/Pro prefer Gemini Live when GEMINI_API_KEY is set; Max/Ultra use OpenAI Realtime.
# Cumulative daily allowance per account across sessions/devices; resets at Manila midnight: Quick 5m, Pro 15m, Max 20m, Ultra 30m.
# The shared USD budgets may shorten/refuse sessions even when voice minutes remain.
# REALTIME_TOKEN_RESERVE_PER_MINUTE=10000  # conservative token quota charged per started voice minute
REALTIME_VOICE_ENABLED=true
REALTIME_QUICK_MODEL=gemini-3.8-live
REALTIME_PRO_MODEL=gemini-3.8-live
REALTIME_MAX_MODEL=gemini-3.8-live
REALTIME_ULTRA_MODEL=gemini-3.8-live
REALTIME_QUICK_MAX_SECONDS=300
REALTIME_PRO_MAX_SECONDS=900
REALTIME_MAX_MAX_SECONDS=1800
REALTIME_ULTRA_MAX_SECONDS=3600
# Who can pick which tier.
TIERS_GUEST=nasrinai,pro
TIERS_USER=nasrinai,pro,max,ultra
# Files with a message: how many, and total size in MB (max 3 on Vercel).
ATTACHMENTS_MAX_COUNT=4
ATTACHMENTS_MAX_MB=3
# Direct uploads (docs/uploads.md): files go from the browser straight to the
# private Supabase bucket `chat-uploads` (migration 031), so they can be larger.
# Needs SUPABASE_URL and SUPABASE_SECRET_KEY. UPLOADS_MAX_MB: 1 to 50 in total
# per message; UPLOADS_PER_HOUR: upload links per person (and twice that per IP).
UPLOADS_DIRECT=false
# Research agent (docs/research.md; migration 036). Off until true.
# RESEARCH_MAX_PAGES: pages read per scan (1-5); RESEARCH_PER_HOUR: scans per person (twice per IP).
RESEARCH_ENABLED=false
RESEARCH_MAX_PAGES=3
RESEARCH_PER_HOUR=10
UPLOADS_MAX_MB=20
UPLOADS_PER_HOUR=60
# Natural voices for reading replies aloud (OpenAI speech; only with AI_PROVIDER=openai).
# false turns them off; the page then uses the phone's own voice.
SPEECH_ENABLED=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Read-aloud speed, 0.5 to 2 (1 = normal). Also used for the phone's own voice.
SPEECH_RATE=1.15
# Reasoning models (o-series, GPT-5): thinking allowance and effort (minimal, low, medium, high).
OPENAI_REASONING_MAX_TOKENS=4000
OPENAI_REASONING_EFFORT=low
# OPENAI_TEMPERATURE=         # leave unset to use the model's default
AI_MAX_REPLY_TOKENS=800
MESSAGE_MAX_CHARS=4000
AI_HISTORY_CHARS=12000
# Provider failover: on outage, quota, busy response, or unsupported attachment,
# try other configured compatible providers and then configured free-model allowlists.
# Auto includes Gemini, OpenAI, Claude, and any eligible free models.
AI_FALLBACK=auto
# Other options: none, gemini, openai, claude (Anthropic)
# Tiers may name a provider: TIER_NASRINAI=local:llama3.1:8b, TIER_PRO=openai:gpt-5-mini

# --- Smart routing (see docs/routing.md) ---
# smart (default with openai/local/auto): cheapest capable model per message.
# fixed: one model per tier (TIER_* above).
# ROUTING=smart
# Candidates per level, cheapest first: provider:model[:effort], comma-separated.
# ROUTE_LEVEL_1=gemini:gemini-3.1-flash-lite,openai:gpt-6-luna:none
# ROUTE_LEVEL_2=openai:gpt-6-luna:low
# ROUTE_LEVEL_3=openai:gpt-5.6-terra:medium
# ROUTE_LEVEL_4=openai:gpt-6.1-sol:high
# ROUTE_LEVEL_5=openai:gpt-6-astra:high
# Highest level each tier may use (the message decides how high it goes).
# ROUTE_RANGE_NASRINAI=1-2
# ROUTE_RANGE_PRO=1-3
# ROUTE_RANGE_MAX=1-4
# ROUTE_RANGE_ULTRA=1-5
# Spending limits, estimated USD. Empty = no limit for that period.
DAILY_BUDGET_USD=3
WEEKLY_BUDGET_USD=21
MONTHLY_BUDGET_USD=90
MAX_REQUEST_COST_USD=0.05
# Per-tier hard request caps. These are enforced server-side in smart routing.
MAX_REQUEST_COST_NASRINAI_USD=0.02
MAX_REQUEST_COST_PRO_USD=0.05
MAX_REQUEST_COST_MAX_USD=0.10
MAX_REQUEST_COST_ULTRA_USD=0.25
MAX_ESCALATION_DEPTH=1
MAX_RETRIES=1
RESPONSE_CACHE_MINUTES=360
# Gemini (optional): cheapest level. Free tier = Google may use what is sent,
# so only messages without contact details or files go there.
# GEMINI_API_KEY=
# GEMINI_FREE_TIER=true

# --- Pictures (needs GEMINI_API_KEY; see docs/features/image-creation.md) ---
# IMAGE_MODEL=gemini-3.1-flash-lite-image
IMAGES_PER_GUEST=1             # per guest session (24 hours)
IMAGES_USER_DAY=5              # per signed-in user per day (Free plan)
IMAGES_MAX_DAY=20              # Max plan, per day
IMAGES_ULTRA_DAY=50            # Ultra plan, per day
IMAGES_GUEST_DAY_TOTAL=50      # all guests together per day (cost ceiling)
# IMAGE_RETENTION_DAYS=30       # days to keep signed-in users' pictures (0 = keep)
# Picture spending limits (USD, estimated), separate from the chat budgets.
# IMAGE_DAILY_BUDGET_USD=1
# IMAGE_WEEKLY_BUDGET_USD=5
# IMAGE_MONTHLY_BUDGET_USD=15
# Picture routes by tier (1 simple, 2 photo edit or words in the picture,
# 3 asked for top quality). Tier 1 = Gemini (IMAGE_MODEL) by default; other
# tiers exist only when set. Each: IMAGE_TIER_n_{PRIMARY,FALLBACK}_{PROVIDER,MODEL,PRICE}
# with PROVIDER gemini or openai, MODEL from the provider's page, PRICE in USD
# per picture (needed for openai). The fallback is used once when the primary
# is down, overloaded, out of quota or its model is unavailable.
# IMAGE_FALLBACK_MODEL=gpt-image-…   # same as IMAGE_TIER_1_FALLBACK_MODEL (openai)
# IMAGE_FALLBACK_PRICE=              # same as IMAGE_TIER_1_FALLBACK_PRICE
# IMAGE_TIER_2_PRIMARY_PROVIDER=openai     # or google (= gemini)
# IMAGE_TIER_2_PRIMARY_MODEL=
# IMAGE_TIER_2_PRIMARY_PRICE=
# IMAGE_TIER_2_PRIMARY_QUALITY=medium      # OpenAI only: low, medium, high, xhigh, max, auto (default high)

# --- The internet (see docs/web.md) ---
# WEB_LINKS=true                # read pages people share (server-side, internal addresses refused)
# OPENROUTER_WEB_SEARCH_MODEL=openrouter/auto # OpenRouter primary search model; empty disables primary search (Google fallback can remain)
# WEB_GOOGLE_API_KEY=                 # optional Google Custom Search JSON API key; server only
# WEB_GOOGLE_CX=                      # optional Programmable Search Engine ID; enables search fallback
LIMIT_GUEST_WEB_HOUR=6
LIMIT_USER_WEB_HOUR=40
LIMIT_GUEST_CITE_HOUR=20
LIMIT_USER_CITE_HOUR=120
# LIMIT_USER_LIBRARY_HOUR=60   # files and notes added per person per hour
# LIMIT_USER_PROJECTS_HOUR=300 # project and task changes per person per hour

# --- Your own model (AI_PROVIDER=local or auto) ---
# Any OpenAI-compatible server: Ollama, llama.cpp, LM Studio, vLLM.
# LOCAL_AI_URL=http://127.0.0.1:11434/v1   # https:// required in production unless on this machine
# LOCAL_AI_MODEL=llama3.1:8b               # the NasrinAI tier; TIER_PRO/MAX/ULTRA may name other models
# One of these is required in production when the server is on another machine:
# LOCAL_AI_KEY=                            # sent as a bearer token (llama.cpp / vLLM --api-key)
# LOCAL_AI_ACCESS_CLIENT_ID=               # Cloudflare Access service token
# LOCAL_AI_ACCESS_CLIENT_SECRET=
# LOCAL_AI_VISION=false                    # true if the model can see photos
# LOCAL_AI_TIMEOUT_SECONDS=100
# Remove emails, phone and card numbers from text sent to an outside model.
REDACT_FOR_EXTERNAL_AI=true

# Required to encrypt user-supplied ElevenLabs API keys at rest. Generate with: openssl rand -hex 32
ELEVENLABS_CREDENTIALS_ENCRYPTION_KEY=

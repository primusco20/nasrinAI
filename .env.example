# NasrinAI server settings. Put real values in Render > Environment.
# Never commit real values. None of these are sent to browsers.

NODE_ENV=production
# Render sets PORT itself.
# Proxies in front of the server (Render = 1). Used to find the real client IP.
TRUST_PROXY_HOPS=1

# --- NasrinAI's own Supabase project (required in production) ---
# Supabase > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=            # anon / publishable key (used only to check sign-ins)
SUPABASE_SERVICE_ROLE_KEY=    # service-role / secret key: server only, never in a page

# --- Guest sessions (required in production) ---
# 32+ random characters. Changing it signs every guest out.
GUEST_SESSION_SECRET=
GUEST_SESSION_TTL_HOURS=24

# --- Limits (optional; defaults shown) ---
# Hourly counts, shared by every server instance.
LIMIT_GUEST_SESSIONS_PER_IP_HOUR=10
LIMIT_GUEST_MESSAGES_HOUR=20
LIMIT_USER_MESSAGES_HOUR=60
LIMIT_SERVICE_MESSAGES_HOUR=600
LIMIT_IP_MESSAGES_HOUR=120
# Daily token budgets, reset at midnight Manila time.
# All NasrinAI guests together; when reached, guests are asked to sign in.
GUEST_DAILY_TOKEN_CEILING=200000
# Each signed-in user.
USER_DAILY_TOKEN_LIMIT=100000
# Each business's total is tenants.daily_token_limit in the database.

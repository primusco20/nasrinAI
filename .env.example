# NasrinAI server settings. Put real values in Vercel > Settings > Environment Variables.
# Never commit real values. None of these are sent to browsers.

NODE_ENV=production
# PORT is only used when running locally.
# Proxies in front of the server (Vercel = 1). Used to find the real client IP.
TRUST_PROXY_HOPS=1

# --- NasrinAI's own Supabase project (required in production) ---
# Supabase > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=            # anon / publishable key (used only to check sign-ins)
SUPABASE_SERVICE_ROLE_KEY=    # service-role / secret key: server only, never in a page

# --- Guest sessions (required in production) ---
# 32+ random characters. Changing it signs every guest out. One way to make it, in
# the Supabase SQL Editor: select encode(extensions.gen_random_bytes(32), 'hex');
GUEST_SESSION_SECRET=
GUEST_SESSION_TTL_HOURS=24

# --- Limits (optional; defaults shown) ---
# Hourly counts, shared by every server instance.
LIMIT_GUEST_SESSIONS_PER_IP_HOUR=10
LIMIT_GUEST_MESSAGES_HOUR=20
LIMIT_USER_MESSAGES_HOUR=60
LIMIT_SERVICE_MESSAGES_HOUR=600
LIMIT_IP_MESSAGES_HOUR=120
# Natural-voice read-alouds (also counted per IP under LIMIT_IP_MESSAGES_HOUR).
LIMIT_GUEST_SPEECH_HOUR=20
LIMIT_USER_SPEECH_HOUR=120
# Daily token budgets, reset at midnight Manila time.
# All NasrinAI guests together; when reached, guests are asked to sign in.
GUEST_DAILY_TOKEN_CEILING=200000
# Each signed-in user.
USER_DAILY_TOKEN_LIMIT=100000
# Each business's total is tenants.daily_token_limit in the database.

# --- AI provider ---
# none (default: chat says it is unavailable), openai, or fake (local test echo; not in production)
AI_PROVIDER=openai
OPENAI_API_KEY=               # server only
# NasrinAI tiers: what people pick in the chat. Each points to a real model,
# optionally with a thinking effort after a colon. Leave one empty to turn it off.
# A tier is only shown if your OpenAI key can use its model.
TIER_NASRINAI=gpt-4o-mini      # the default, open to everyone (OPENAI_MODEL also sets it)
TIER_PRO=gpt-5-mini
TIER_MAX=gpt-5
TIER_ULTRA=gpt-5:high
# Who can pick which tier.
TIERS_GUEST=nasrinai,pro
TIERS_USER=nasrinai,pro,max,ultra
# Files with a message: how many, and total size in MB (max 3 on Vercel).
ATTACHMENTS_MAX_COUNT=4
ATTACHMENTS_MAX_MB=3
# Natural voices for reading replies aloud (OpenAI speech; only with AI_PROVIDER=openai).
# false turns them off; the page then uses the phone's own voice.
SPEECH_ENABLED=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Reasoning models (o-series, GPT-5): thinking allowance and effort (minimal, low, medium, high).
OPENAI_REASONING_MAX_TOKENS=4000
OPENAI_REASONING_EFFORT=low
# OPENAI_TEMPERATURE=         # leave unset to use the model's default
AI_MAX_REPLY_TOKENS=800
MESSAGE_MAX_CHARS=4000
AI_HISTORY_CHARS=12000
# Remove emails, phone and card numbers from text sent to an outside model.
REDACT_FOR_EXTERNAL_AI=true
